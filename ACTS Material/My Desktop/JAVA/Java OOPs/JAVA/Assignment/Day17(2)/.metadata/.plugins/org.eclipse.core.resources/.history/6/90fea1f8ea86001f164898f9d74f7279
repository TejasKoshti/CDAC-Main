package com.cdac.acts.operations;



import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.io.IOException;
import java.io.ObjectInputStream;
import java.io.ObjectOutputStream;
import java.util.HashMap;
import java.util.Map;

import com.cdac.acts.printer.Printer;

public class Operation {
	private Operation() {
	}

	public static void addToFile(Integer id, Printer p) {
		try (FileOutputStream fos = new FileOutputStream("printer.txt");
			ObjectOutputStream oos = new ObjectOutputStream(fos); ) {
			if (p == null) {
				return;
			}
			System.out.println(id);
			oos.writeInt(id);
			oos.writeObject(p);
		} catch (IOException eof) {
			System.out.println("Writern Succesfully");
		}
	}

	public static Map<Integer, Printer> getFromFile() {

		Map<Integer, Printer> newMap = new HashMap<>();

		try (FileInputStream fis = new FileInputStream("printer.txt");
				ObjectInputStream ois = new ObjectInputStream(fis);) {

			while (ois.available() != -1) {
				int id = ois.readInt();
				System.out.println(id);
				Printer p = (Printer) ois.readObject();
				newMap.put(id, p);
			}
		} catch (IOException eof) {
			System.err.println(eof.getMessage());
		} catch (ClassNotFoundException cnfe) {
			System.err.println(cnfe.getMessage());
		}
		return newMap;
	}
}
