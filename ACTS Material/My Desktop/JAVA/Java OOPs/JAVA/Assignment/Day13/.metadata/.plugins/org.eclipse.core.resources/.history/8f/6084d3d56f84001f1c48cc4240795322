package com.cdac.acts;

import java.util.Objects;

public final class StudentKey_SirMethod {    // Final Class C
	
	private final String standard;           // Final DM
	private final Integer division;			// Final DM
	private final Integer rollNo;			// Final DM
	
	public StudentKey_SirMethod(String standard, Integer division, Integer rollNo) {
		super();
		this.standard = standard;
		this.division = division;
		this.rollNo = rollNo;
	}
	@Override
	public int hashCode() {
		return Objects.hash(division, rollNo, standard);
	}
	@Override
	public boolean equals(Object obj) {
		if (this == obj)
			return true;
		if (obj == null)
			return false;
		if (getClass() != obj.getClass())
			return false;
		StudentKey_SirMethod other = (StudentKey_SirMethod) obj;
		return Objects.equals(division, other.division) && Objects.equals(rollNo, other.rollNo)
				&& Objects.equals(standard, other.standard);
	}
	@Override
	public String toString() {
		return "StudentKey [standard=" + standard + ", division=" + division + ", rollNo=" + rollNo + "]";
	}
	
	// Only Getters
	

}
