package com.cdac.acts.person;

import java.util.Date;

import com.cdac.acts.address.Address;
import com.cdac.acts.date_utils.MyDate;

public class Person {
	private long aadharNo;
	private String name;
	private Date doj;
	private Address address;
	
	private long idGenerator = 49505120001L;
	public Person() {
		this.aadharNo = idGenerator;
		this.name = "";
		this.doj = null;
		this.address = null;
		idGenerator++;
	}
	
	public Person (String name, Date date, Address address) {
		this.aadharNo = idGenerator;
		this.name = name;
		this.doj = date;
		this.address = address;
		idGenerator++;
	}
	
	public boolean checkIf (Date date) {
		
		return true;
	}

	@Override
	public String toString() {
		return "Person [aadharNo: " + aadharNo + ", name: " + name + ", date: " + MyDate.setDateFormat(doj) + ",\n "  + address
			 + "]";
	}
}
