class A {
	public void hi() {
		System.out.println("A::Hi");
	}
}

class B extends A {

	@Override
	public void hi() {
		System.out.println("B::Hi");
	}
}

public class Inheritance {
	public static void main(String[] args) {
		A a = new A();
		a.hi();

		if (a instanceof B) {
			a = new B();
			a.hi();
		}
	}
}
