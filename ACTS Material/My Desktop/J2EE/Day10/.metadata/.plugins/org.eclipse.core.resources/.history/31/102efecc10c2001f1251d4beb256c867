spring.application.name=SpringBootHiberApp

# DataSource Configuration
spring.datasource.url=jdbc:mysql://localhost:3306/onlineshopping"
spring.datasource.username=root
spring.datasource.password=cdac

# Hibernate Dialect for MySQL
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL8Dialect

# Hibernate HBM2DD Auto Setting
spring.jpa.hibernate.ddl-auto=update  # Options: update, create, create-drop, validate
spring.jpa.properties.hibernate.hbm2ddl.auto=update  # This can also be 'validate' or 'create-drop'
spring.jpa.properties.hibernate.show_sql=true  # Optional, to show SQL queries in the logs
spring.jpa.properties.hibernate.format_sql=true  # Optional, formats SQL in logs for readability

# Enable JPA Repositories (if needed)
spring.data.jpa.repositories.enabled=true
