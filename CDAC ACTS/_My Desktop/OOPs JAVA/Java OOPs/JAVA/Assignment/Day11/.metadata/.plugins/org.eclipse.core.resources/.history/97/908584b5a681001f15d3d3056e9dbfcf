package com.cdac.acts.fruits.tester;

import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.Scanner;

import com.cdac.acts.comparator.ColorComparator;
import com.cdac.acts.comparator.PriceComparator;
import com.cdac.acts.comparator.QuantityComparator;
import com.cdac.acts.fruits.Fruits;

public class FruitsTester {

	public static void main(String[] args) {
		List<Fruits> list = new ArrayList<>();

		Scanner sc = new Scanner(System.in);

		while (true) {
			System.out.println("0. exit");
			System.out.println("1. Add fruit");
			System.out.println("2. Sort fruits by color");
			System.out.println("3. Sort by quantity");
			System.out.println("4. Sort by price");
			System.out.println("5. display");

			System.out.println("enter choice");
			int choice = sc.nextInt();
			sc.nextLine();

			switch (choice) {

			case 0:
				System.exit(0);

			case 1: {
				System.out.println("enter name");
				String name = sc.nextLine();

				System.out.println("enter color");
				String color = sc.nextLine();

				System.out.println("enter quantity");
				int quantity = sc.nextInt();

				System.out.println("enter price");
				int price = sc.nextInt();
				list.add(new Fruits(name, color, quantity, price));

			}
				break;

			case 2: {
				Collections.sort(list, new ColorComparator());
			}
				break;

			case 3: {
				Collections.sort(list, new QuantityComparator());
			}
				break;

			case 4: {
				Collections.sort(list, new PriceComparator());
			}
				break;

			case 5: {
				list.forEach(System.out::println);
			}
				break;
			}

		}
	}
}
