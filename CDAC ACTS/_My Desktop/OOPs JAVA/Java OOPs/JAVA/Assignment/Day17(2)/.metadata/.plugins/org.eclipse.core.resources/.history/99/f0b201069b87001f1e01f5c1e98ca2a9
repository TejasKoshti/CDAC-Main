package com.cdac.acts.book.tester;

import java.time.LocalDate;
import java.util.List;

import com.cdac.acts.book.Book;
import com.cdac.acts.book.DataUtils;
import com.cdac.acts.book.enums.BookType;
import com.cdac.acts.book.io.FileInputOutput;

public class BookTester {
	public static void main(String[] args) {
		List<Book> list = DataUtils.getBooksList();
		for (Book b : list) {
			FileInputOutput.writeToFile(b);
		}

		List<Book> bookList = FileInputOutput.readFromFile();
		bookList.forEach(System.out::println);
		
		System.out.println(FileInputOutput.getOneObject(""));

	}
}
