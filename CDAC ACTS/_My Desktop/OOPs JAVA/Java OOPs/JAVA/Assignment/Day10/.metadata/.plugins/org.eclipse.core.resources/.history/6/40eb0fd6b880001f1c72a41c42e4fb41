abstract class A {
	public void hi() {
		System.out.println("A::Hi");
	}

//	private abstract Object hello1();

	abstract Object hello(String msg);
}

class B extends A {

	@Override
	public void hi() {
		System.out.println("B::Hi");
	}

	// object to string is co-varience
	// protected to public is improving access specifier
	@Override
	protected String hello(String msg) {
			 return "B::Hello";
	}

public class Inheritance {
	public static void main(String[] args) throw {
		A a = new B();
		a.hi();

		a = new B();
		if (a instanceof B) {
			B b1 = (B) a;
			b1.hi();
		}
	}
}
