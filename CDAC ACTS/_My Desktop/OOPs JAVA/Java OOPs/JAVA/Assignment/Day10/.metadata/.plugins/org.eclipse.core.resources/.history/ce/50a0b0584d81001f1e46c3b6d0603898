import java.util.Scanner;

public class MobNumberFormater {

	public static String format(String no) {
		
		for (char ch : no.toCharArray()) {
			if (!Character.isDigit(ch)) {
				return "only number are allowed";
			}
		}
		
		StringBuilder sb = new StringBuilder(no);
		if (no.length() == 16 || no.length() == 14 || no.length() == 13) {
			String temp = "+91-";

			if (no.length() == 13) {
				for (int i = 0; i < 3; i++) {
					if (sb.charAt(i) != temp.charAt(i)) {
						return "invalid input";
					}
				}
				sb.delete(0, 3);
			}

			if (no.length() == 14 || no.length() == 16) {
				for (int i = 0; i < 4; i++) {
					if (sb.charAt(i) != temp.charAt(i)) {
						return "invalid input";
					}
				}
				sb.delete(0, 4);
			}
		}

		int tempLength = sb.length();

		if (sb.length() == 10 || sb.length() == 12) {
			for (int i = 0; i < tempLength; i++) {
				if (sb.charAt(i) == '-') {
					if (i == 3 || i == 6) {
						sb.deleteCharAt(i);
						tempLength--;
						i--;
					} else {
						return "invalid input";
					}
				}
			}
		} else {
			return "invalid input";
		}

		sb.insert(0, "+91-");
		sb.insert(7, '-');
		sb.insert(11, '-');

		return sb.toString();
	}

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		System.out.println("enter number ");
		String n = sc.next();
		System.out.println(format(n));
		sc.close();
	}

}
