abstract class A {
	public void hi() {
		System.out.println("A::Hi");
	}
	
	protected abstract Object hello();
}

class B extends A {

	@Override
	public void hi() {
		System.out.println("B::Hi");
	}
	
	@Override
	public String hello() {
		return "B::Hello";
	}
}

public class Inheritance {
	public static void main(String[] args) {
		A a = new A();
		a.hi();

		a = new B();
		if (a instanceof B) {
			B b1 = (B) a;
			b1.hi();
		}
	}
}
