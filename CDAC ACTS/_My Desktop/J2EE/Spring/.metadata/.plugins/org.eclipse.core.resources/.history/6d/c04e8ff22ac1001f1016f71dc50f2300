package fi.springmvcjdbc.dao;

import java.util.List;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.core.env.Environment;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Component;

import fi.springmvc.beans.Users;
import jakarta.annotation.PostConstruct;

@Component
public class UsersDAOImpl implements UsersDAO {

    @Autowired
    JdbcTemplate jdbcTemplate;

    @Autowired
    Environment env;

    private String sqlRegister;
    private String sqlChangePassword;
    private String sqlAllUsers;
    private String sqlUserDetails;

    @PostConstruct
    public void initialize() {
        // Correcting the assignment statements
        sqlRegister = env.getProperty("sql.registeruser");
        sqlChangePassword = env.getProperty("sql.changepassword");
        sqlAllUsers = env.getProperty("sql.allusers");
        sqlUserDetails = env.getProperty("sql.userdetails");
    }

    @Override
    public boolean registerUser(String userName, String password, String name, String email) {
        // Register the user using JdbcTemplate
        jdbcTemplate.update(sqlRegister, userName, password, name, email);
        return true; // Return true after successful registration
    }

    @Override
    public boolean changePassword(String userName, String password) {
        // Change the password using JdbcTemplate
        jdbcTemplate.update(sqlChangePassword, userName, password);
        return true; // Return true after successful password change
    }

    @Override
    public Users getUserDetails(String userName) {
        // Fetch user details using JdbcTemplate
        return jdbcTemplate.queryForObject(sqlUserDetails, new Object[]{userName}, new UsersRowMapper());
    }

    @Override
    public List<Users> getAllUsers() {
        // Fetch all users and return as a list
        return jdbcTemplate.query(sqlAllUsers, new UsersRowMapper());
    }
}

}
